# Copy to .env and replace the placeholders with your own values.
# Local Vite app origin. Use the URL the browser opens; this project uses port 5173.
# Sandbox accepts localhost/http. Production requires a public HTTPS origin with no trailing slash.
APP_URL=http://localhost:5173

# Set this in Hostinger's build environment for production frontend API requests.
# Leave blank locally; Vite proxies /config and /api to the local backend.
VITE_API_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=webinar_reg

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Cashfree credentials must stay on the backend, never in VITE_* variables.
# Local testing: use sandbox credentials with CASHFREE_ENV=sandbox (or test).
# Production: set CASHFREE_ENV=production and APP_URL=https://yourdomain.com
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

PORT=3000
NODE_ENV=development
ADMIN_PASSWORD=replace-with-a-long-random-password
