# Copy to .env and replace the placeholders with your own values.
# Production public URL; local development uses the Vite origin on port 5173.
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=webinar_reg

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

PORT=3000
NODE_ENV=development
ADMIN_PASSWORD=replace-with-a-long-random-password
