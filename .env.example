# Copy to .env and replace the placeholders with your own values.
# Browser-facing app origin (port 3000 for the combined server; use 5173 with Vite).
# Sandbox accepts localhost/http. Production requires a public HTTPS origin.
APP_URL=http://localhost:3000

# Set this in Hostinger's build environment for production frontend API requests.
# Leave blank locally; Vite proxies /config and /api to the local backend.
VITE_API_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=webinar_reg

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Keep all Cashfree credentials on the backend; never put them in VITE_* variables.
# Select exactly one set with CASHFREE_ENV. Invalid or missing values default to sandbox.
CASHFREE_ENV=sandbox
# Cashfree test credentials (used only when CASHFREE_ENV=sandbox).
CASHFREE_TEST_APP_ID=
CASHFREE_TEST_SECRET_KEY=
# Cashfree live credentials (used only when CASHFREE_ENV=production).
CASHFREE_LIVE_APP_ID=
CASHFREE_LIVE_SECRET_KEY=

PORT=3000
NODE_ENV=development
